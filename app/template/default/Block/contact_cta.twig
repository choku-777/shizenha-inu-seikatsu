{#
    お問い合わせ(CTA)セクション
#}
<section class="contact-cta-section" style="padding: var(--section-padding); background-color: var(--color-primary-dark); color: var(--color-white);">
    <div class="container">
        <div class="grid grid-2" style="align-items: stretch;">
            <div>
                <h3 style="color: var(--color-white); margin-bottom: 10px; font-family: var(--font-body);">自然派いぬ生活 カスタマーサポート</h3>
                <p style="font-size: 0.9rem; margin-bottom: 20px;">
                    大陸通商株式会社 自然派いぬ生活事業部<br>
                    〒375-0005 群馬県藤岡市中187-1
                </p>
                <div style="background-color: var(--color-white); color: var(--color-text); padding: 20px; border-radius: 8px; display: flex; align-items: center; gap: 15px; margin-bottom: 20px;">
                    <i class="fas fa-phone-alt" style="color: var(--color-primary); font-size: 2rem;"></i>
                    <div>
                        <div style="font-size: 0.9rem; font-weight: bold; color: var(--color-primary);">お電話でのお問い合わせ</div>
                        <div style="font-size: 1.8rem; font-weight: bold;">0274-20-1212</div>
                        <div style="font-size: 0.8rem;">受付時間 9:00-18:00（土日祝休み）</div>
                    </div>
                </div>
                <div style="background-color: var(--color-white); color: var(--color-text); padding: 16px 20px; border-radius: 8px; display: flex; align-items: center; gap: 15px;">
                    <i class="fas fa-envelope" style="color: var(--color-primary); font-size: 1.8rem;"></i>
                    <div>
                        <div style="font-size: 0.9rem; font-weight: bold; color: var(--color-primary);">メールでのお問い合わせ</div>
                        <div style="font-size: 1rem; font-weight: bold;">support@shizenha-inu.life</div>
                    </div>
                </div>
            </div>

            <div style="text-align: center; background-color: rgba(255,255,255,0.1); padding: 40px; border-radius: 12px; display: flex; flex-direction: column; justify-content: center;">
                <i class="fas fa-envelope" style="font-size: 3rem; margin-bottom: 15px;"></i>
                <h3 style="color: var(--color-white); margin-bottom: 10px;">WEBでのお問い合わせ</h3>
                <p style="font-size: 0.95rem; margin-bottom: 25px;">確認とお返事に2営業日ほどいただきます</p>
                <a href="{{ url('contact') }}" class="btn" style="background-color: var(--color-white); color: var(--color-primary-dark); width: 100%; max-width: 300px; margin: 0 auto;">メールで相談する</a>
            </div>
        </div>
    </div>
</section>
