{#
    商品一覧ページ - 自然派いぬ生活カスタムデザイン
#}
{% extends 'default_frame.twig' %}

{% set body_class = 'product_page' %}

{% block stylesheet %}
    <link rel="stylesheet" href="{{ asset('assets/css/product_list.css', 'user_data') }}">
{% endblock %}

{% block javascript %}
    <script>
        eccube.productsClassCategories = {
            {% for Product in pagination %}
            "{{ Product.id|escape('js') }}": {{ class_categories_as_json(Product)|raw }}{% if loop.last == false %}, {% endif %}
            {% endfor %}
        };

        $(function() {

            // 表示件数を変更
            $('.disp-number').change(function() {
                var dispNumber = $(this).val();
                $('#disp_number').val(dispNumber);
                $('#pageno').val(1);
                $("#form1").submit();
            });

            // 並び順を変更
            $('.order-by').change(function() {
                var orderBy = $(this).val();
                $('#orderby').val(orderBy);
                $('#pageno').val(1);
                $("#form1").submit();
            });

            // 数量プラス/マイナス
            $(document).on('click', '.qty-btn--minus', function() {
                var $input = $(this).siblings('.qty-input');
                var val = parseInt($input.val()) || 1;
                if (val > 1) $input.val(val - 1);
            });
            $(document).on('click', '.qty-btn--plus', function() {
                var $input = $(this).siblings('.qty-input');
                var val = parseInt($input.val()) || 1;
                $input.val(val + 1);
            });

            $('.add-cart').on('click', function(e) {
                var $form = $(this).parents('.product-card').find('form');

                // 数量同期
                var $cardQty = $(this).parents('.product-card').find('.qty-input');
                var $formQty = $form.find('.quantity');
                if ($cardQty.length && $formQty.length) {
                    $formQty.val($cardQty.val());
                }

                var $quantity = $form.find('.quantity');
                if ($quantity.val() < 1) {
                    $quantity[0].setCustomValidity('{{ 'front.product.invalid_quantity'|trans }}');
                    setTimeout(function() {
                        loadingOverlay('hide');
                    }, 100);
                    return true;
                } else {
                    $quantity[0].setCustomValidity('');
                }
                e.preventDefault();
                $.ajax({
                    url: $form.attr('action'),
                    type: $form.attr('method'),
                    data: $form.serialize(),
                    dataType: 'json',
                    beforeSend: function(xhr, settings) {
                        $('.add-cart').prop('disabled', true);
                    }
                }).done(function(data) {
                    $.each(data.messages, function() {
                        $('#ec-modal-header').text(this);
                    });
                    $('.ec-modal').show()
                    $.ajax({
                        url: '{{ url('block_cart') }}',
                        type: 'GET',
                        dataType: 'html'
                    }).done(function(html) {
                        $('.ec-headerRole__cart').html(html);
                    });
                }).fail(function(data) {
                    alert('{{ 'front.product.add_cart_error'|trans }}');
                }).always(function(data) {
                    $('.add-cart').prop('disabled', false);
                });
            });
        });

        $('.ec-modal-wrap').on('click', function(e) {
            e.stopPropagation();
        });
        $('.ec-modal-overlay, .ec-modal, .ec-modal-close, .ec-inlineBtn--cancel').on('click', function() {
            $('.ec-modal').hide()
        });
    </script>
{% endblock %}

{% block main %}
    {% if search_form.category_id.vars.errors|length > 0 %}
        <div class="container"><p class="errormsg text-danger">{{ 'front.product.search__category_not_found'|trans }}</p></div>
    {% else %}

    {# ヒーロー #}
    <section class="product-list-hero" style="background-image: url('{{ asset('assets/img/products_hero.webp', 'user_data') }}');">
        <div class="product-list-hero__overlay"></div>
        <div class="container">
            <div class="product-list-hero__inner">
                <h1 class="product-list-hero__title">商品一覧</h1>
            </div>
        </div>
    </section>

    {# 検索フォーム（非表示・状態保持用） #}
    <form name="form1" id="form1" method="get" action="?">
        {% for item in search_form %}
            <input type="hidden" id="{{ item.vars.id }}" name="{{ item.vars.full_name }}"
                   {% if item.vars.value is not empty %}value="{{ item.vars.value }}" {% endif %}/>
        {% endfor %}
    </form>

    <div class="container product-list-container">
        <div class="product-list-layout">

            {# サイドバー #}
            <aside class="product-list-sidebar">
                {# カテゴリ #}
                <div class="sidebar-box">
                    <h3 class="sidebar-box__title">カテゴリから探す</h3>
                    <ul class="sidebar-category-list">
                        {% set Categories = repository('Eccube\\Entity\\Category').getList() %}
                        {% for ParentCategory in Categories %}
                            <li>
                                <a href="{{ url('product_list') }}?category_id={{ ParentCategory.id }}"
                                   class="{% if Category is not null and Category.id == ParentCategory.id %}is-active{% endif %}">
                                    {{ ParentCategory.name }}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </div>

                {# おすすめ特集 #}
                <div class="sidebar-box sidebar-box--featured">
                    <h3 class="sidebar-box__title">おすすめ特集</h3>
                    <a href="{{ url('user_data', {'route': 'trial'}) }}" class="sidebar-featured">
                        <div class="sidebar-featured__image">
                            <img src="{{ asset('assets/img/sidebar_trial.webp', 'user_data') }}" alt="初回限定トライアルセット" loading="lazy" onerror="this.style.display='none'">
                        </div>
                        <div class="sidebar-featured__label">初回限定トライアルセット</div>
                        <div class="sidebar-featured__sub">特別価格でお試し</div>
                    </a>
                </div>

                {# はじめての方へ #}
                <a href="#" class="sidebar-cta">
                    <h4 class="sidebar-cta__title">はじめての方へ</h4>
                    <p class="sidebar-cta__text">自然派いぬ生活の<br>こだわりを見る</p>
                </a>
            </aside>

            {# メインコンテンツ #}
            <main class="product-list-main">
                {# トピックパス #}
                {% if Category is not null %}
                    <ol class="product-list-topicpath">
                        <li><a href="{{ url('product_list') }}">{{ 'front.product.all_category'|trans }}</a></li>
                        {% for Path in Category.path %}
                            <li class="sep">/</li>
                            <li{% if loop.last %} class="active"{% endif %}>
                                <a href="{{ url('product_list') }}?category_id={{ Path.id }}">{{ Path.name }}</a>
                            </li>
                        {% endfor %}
                    </ol>
                {% endif %}

                {# 件数 + ソート #}
                <div class="product-list-toolbar">
                    <div class="product-list-toolbar__count">
                        {% if pagination.totalItemCount > 0 %}
                            {{ 'front.product.search_result__detail'|trans({ '%count%': pagination.totalItemCount })|raw }}
                        {% else %}
                            <span>{{ 'front.product.search__product_not_found'|trans }}</span>
                        {% endif %}
                    </div>
                    {% if pagination.totalItemCount > 0 %}
                        <div class="product-list-toolbar__filters">
                            {{ form_widget(search_form.disp_number, {'id': '', 'attr': {'class': 'disp-number'}}) }}
                            {{ form_widget(search_form.orderby, {'id': '', 'attr': {'class': 'order-by'}}) }}
                        </div>
                    {% endif %}
                </div>

                {# 商品グリッド #}
                {% if pagination.totalItemCount > 0 %}
                <div class="product-grid">
                    {% for Product in pagination %}
                        <div class="product-card">
                            <a href="{{ url('product_detail', {'id': Product.id}) }}" class="product-card__image">
                                <img src="{{ asset(Product.main_list_image|no_image_product, 'save_image') }}" alt="{{ Product.name }}" {% if loop.index > 5 %}loading="lazy"{% endif %}>
                            </a>
                            <div class="product-card__body">
                                <a href="{{ url('product_detail', {'id': Product.id}) }}" class="product-card__name">
                                    {{ Product.name }}
                                </a>
                                <p class="product-card__price">
                                    {% if Product.hasProductClass %}
                                        {% if Product.getPrice02Min == Product.getPrice02Max %}
                                            {{ Product.getPrice02IncTaxMin|price }}
                                        {% else %}
                                            {{ Product.getPrice02IncTaxMin|price }} 〜 {{ Product.getPrice02IncTaxMax|price }}
                                        {% endif %}
                                    {% else %}
                                        {{ Product.getPrice02IncTaxMin|price }}
                                    {% endif %}
                                </p>

                                {% if Product.stock_find %}
                                    {% set form = forms[Product.id] %}
                                    <form name="form{{ Product.id }}" id="productForm{{ Product.id }}" action="{{ url('product_add_cart', {id:Product.id}) }}" method="post" class="product-card__form">
                                        {% if form.classcategory_id1 is defined %}
                                            <div class="product-card__select">
                                                {{ form_widget(form.classcategory_id1) }}
                                                {{ form_errors(form.classcategory_id1) }}
                                            </div>
                                            {% if form.classcategory_id2 is defined %}
                                                <div class="product-card__select">
                                                    {{ form_widget(form.classcategory_id2) }}
                                                    {{ form_errors(form.classcategory_id2) }}
                                                </div>
                                            {% endif %}
                                        {% endif %}
                                        {{ form_widget(form.quantity, {'attr': {'class': 'quantity', 'style': 'display:none'}}) }}
                                        {{ form_rest(form) }}
                                    </form>
                                    <div class="product-card__qty">
                                        <button type="button" class="qty-btn qty-btn--minus" aria-label="数量を減らす">−</button>
                                        <input type="number" class="qty-input" value="1" min="1">
                                        <button type="button" class="qty-btn qty-btn--plus" aria-label="数量を増やす">＋</button>
                                    </div>
                                    <button type="submit" class="product-card__cart-btn add-cart" data-cartid="{{ Product.id }}" form="productForm{{ Product.id }}">
                                        {{ 'front.product.add_cart'|trans }}
                                    </button>
                                {% else %}
                                    <button type="button" class="product-card__cart-btn product-card__cart-btn--disabled" disabled>
                                        {{ 'front.product.out_of_stock'|trans }}
                                    </button>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                </div>

                <div class="ec-modal">
                    <div class="ec-modal-overlay">
                        <div class="ec-modal-wrap">
                            <span class="ec-modal-close"><span class="ec-icon"><img src="{{ asset('assets/icon/cross-dark.svg') }}" alt=""/></span></span>
                            <div id="ec-modal-header" class="text-center">{{ 'front.product.add_cart_complete'|trans }}</div>
                            <div class="ec-modal-box">
                                <div class="ec-role">
                                    <span class="ec-inlineBtn--cancel">{{ 'front.product.continue'|trans }}</span>
                                    <a href="{{ url('cart') }}" class="ec-inlineBtn--action">{{ 'common.go_to_cart'|trans }}</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="product-list-pagination">
                    {% include "pager.twig" with {'pages': pagination.paginationData} %}
                </div>
                {% endif %}
            </main>

        </div>
    </div>
    {% endif %}
{% endblock %}
